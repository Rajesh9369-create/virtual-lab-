# ------------------------------------------------------------------
# Pharma Virtual Lab — backend configuration
#
# Copy this file to `.env.local` and fill in real values.
#
# These two values are SAFE to expose in browser code — the anon key is
# designed to be public and all data access is enforced by Row Level
# Security in PostgreSQL, never by hiding this key.
#
# The service-role key and database password must NEVER be placed here.
# They belong only in server-side/CI secrets.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
